{
  "model": "claude-opus-4-8",
  "fast_mode": true,
  "permissions": {
    "allowlist": [
      "bash:npm install",
      "bash:npm test",
      "bash:npm run",
      "bash:git status",
      "bash:git log",
      "bash:git diff",
      "bash:git add",
      "bash:git commit",
      "bash:git push",
      "bash:git fetch",
      "bash:git pull",
      "bash:git branch",
      "bash:git checkout",
      "bash:yarn install",
      "bash:yarn test",
      "bash:pnpm install",
      "bash:pnpm test",
      "bash:curl",
      "bash:wget",
      "read:*",
      "edit:*",
      "glob:*",
      "grep:*",
      "mcp__github__*",
      "mcp__Gmail__*",
      "mcp__Google_Calendar__*",
      "mcp__Google_Drive__*",
      "mcp__HA-MCP__*",
      "mcp__Canva__*"
    ]
  },
  "hooks": {
    "pre-commit": "npm run lint -- --fix 2>/dev/null || true",
    "on-start": "npm install --silent 2>/dev/null || true",
    "on-homeassistant-trigger": "echo '🏠 Home Assistant automation triggered'"
  },
  "statusline": {
    "show_tokens": true,
    "show_model": true,
    "show_time": true
  },
  "editor": {
    "auto_format": true,
    "format_on_save": true,
    "trim_trailing_whitespace": true
  },
  "specialization": {
    "home_assistant": {
      "enabled": true,
      "auto_apply_best_practices": true,
      "dashboard_design_enabled": true,
      "automation_templates": true
    },
    "music_generation": {
      "enabled": true,
      "provider": "suno",
      "auto_generate_on_request": true
    },
    "design_system": {
      "enabled": true,
      "canva_integration": true,
      "dashboard_templates": true
    },
    "design_excellence": {
      "enabled": true,
      "framework": "emil_kowalsky",
      "impeccable_system": true,
      "taste_skill": true,
      "auto_apply_standards": true
    }
  },
  "mcp_servers": {
    "github": {
      "enabled": true,
      "command": "npx",
      "args": ["@modelcontextprotocol/server-github"]
    },
    "gmail": {
      "enabled": true,
      "command": "npx",
      "args": ["@modelcontextprotocol/server-gmail"]
    },
    "google_calendar": {
      "enabled": true,
      "command": "npx",
      "args": ["@modelcontextprotocol/server-google-calendar"]
    },
    "google_drive": {
      "enabled": true,
      "command": "npx",
      "args": ["@modelcontextprotocol/server-google-drive"]
    },
    "home_assistant": {
      "enabled": true,
      "description": "Home Assistant automation, dashboards, integrations"
    },
    "canva": {
      "enabled": true,
      "description": "Canva design for dashboards and presentations"
    }
  }
}
