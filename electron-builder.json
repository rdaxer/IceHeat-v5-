{
  "appId": "com.iceheat.desktop",
  "productName": "IceHeat Desktop",
  "directories": {
    "buildResources": "build",
    "output": "dist"
  },
  "files": [
    "src/",
    "reel/",
    "index.html",
    "manifest.json",
    "service-worker.js",
    "icon-192.png",
    "icon-512.png",
    "assets/",
    "node_modules/"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "certificateFile": null,
    "signingHashAlgorithms": ["sha256"],
    "sign": null
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "IceHeat Desktop",
    "installerIcon": "build/icons/setup.ico",
    "uninstallerIcon": "build/icons/uninstall.ico",
    "installerHeaderIcon": "build/icons/app.ico",
    "installerSidebar": "build/installer-background.bmp",
    "deleteAppDataOnUninstall": false,
    "artifactName": "${productName}-${version}-Installer.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-${version}-Portable.${ext}"
  }
}
