{
  "appId": "com.videoreel.pro",
  "productName": "VideoReel Pro",
  "directories": {
    "output": "dist"
  },
  "files": [
    "src/**/*",
    "reel/**/*",
    "icon-192.png",
    "icon-512.png",
    "package.json"
  ],
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "VideoReel Pro",
    "deleteAppDataOnUninstall": false,
    "artifactName": "VideoReel-Pro-${version}-Installer.${ext}"
  },
  "portable": {
    "artifactName": "VideoReel-Pro-${version}-Portable.${ext}"
  }
}
