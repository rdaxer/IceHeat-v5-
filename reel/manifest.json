{
  "name": "Reel Generator — Video für Social Media",
  "short_name": "Reel Generator",
  "description": "Erstelle professionelle Video-Reels für TikTok, Instagram & YouTube mit intelligenter Szenenanalyse und automatischen Hooks",
  "start_url": "index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0f1117",
  "theme_color": "#0ea5e9",
  "icons": [
    {
      "src": "../icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "../icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "../screenshot-1.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "../screenshot-2.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],
  "categories": ["video", "multimedia", "productivity"],
  "shortcuts": [
    {
      "name": "Neues Projekt",
      "short_name": "Neues Projekt",
      "description": "Starten Sie ein neues Reel-Projekt",
      "url": "index.html?tab=upload",
      "icons": [
        {
          "src": "../icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Editor öffnen",
      "short_name": "Editor",
      "description": "Öffnen Sie den Video-Editor",
      "url": "index.html?tab=editor",
      "icons": [
        {
          "src": "../icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "index.html?shared=true",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "video",
          "accept": ["video/*", "image/*"]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+reel",
      "url": "index.html?open=%s"
    }
  ],
  "prefer_related_applications": false
}
