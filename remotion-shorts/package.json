{
  "name": "iceheat-remotion-shorts",
  "version": "1.0.0",
  "private": true,
  "description": "Automatische YouTube-Shorts (9:16) aus IceHeat-Renndaten mit Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render:heat": "remotion render HeatCard out/heat.mp4",
    "render:standings": "remotion render Standings out/standings.mp4",
